# Release signing for CFlip - COPY this file to keystore.properties and
# fill in your own values. NEVER commit keystore.properties, *.keystore or
# *.jks to GitHub (they are in .gitignore). Keep the keystore file backed
# up privately: losing it means a future update needs a fresh install.
#
# storeFile is relative to the app/ directory, so ../ means the project root.
storeFile=../cflip-release.keystore
storePassword=MATKHAU_CUA_CAU
keyAlias=cflip
keyPassword=MATKHAU_CUA_CAU
