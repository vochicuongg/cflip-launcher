<?xml version="1.0" encoding="utf-8"?>
<!-- vc246 CASSETTE SMALL: Samsung cover-screen meta-data (display=
     "sub_screen") so the compact cassette widget appears in Samsung's
     cover widget picker, same pattern as the other 4 widgets. -->
<samsung-appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    display="sub_screen">
    <appwidget-provider
        android:minWidth="352dp"
        android:minHeight="160dp"
        android:initialLayout="@layout/widget_music_small"
        android:previewLayout="@layout/widget_music_small"
        android:updatePeriodMillis="0"
        android:resizeMode="horizontal|vertical"
        android:widgetCategory="keyguard" />
</samsung-appwidget-provider>
