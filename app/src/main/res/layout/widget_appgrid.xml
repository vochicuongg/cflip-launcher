<?xml version="1.0" encoding="utf-8"?>
<!-- vc246: same card + padding as the other widgets (was a flat
     #08090A bg with 8dp padding); header button is a round mint
     icon button now (provider still sets its "↻"/"←" text). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/bg_widget_card"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">
        <TextView
            android:id="@+id/app_grid_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="CFlip — Ứng dụng"
            android:textColor="#F5F7F6"
            android:textSize="14sp"
            android:textStyle="bold" />
        <Button
            android:id="@+id/app_grid_refresh"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:minWidth="40dp"
            android:minHeight="40dp"
            android:background="@drawable/bg_widget_circle"
            android:textColor="#7FE3C0"
            android:text="↻"
            android:textSize="16sp" />
    </LinearLayout>

    <GridView
        android:id="@+id/app_grid"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:numColumns="4"
        android:verticalSpacing="10dp"
        android:horizontalSpacing="10dp"
        android:stretchMode="columnWidth"
        android:gravity="center" />

    <TextView
        android:id="@+id/app_grid_empty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Chưa có ứng dụng"
        android:textColor="#9AA8A1"
        android:textSize="12sp" />
</LinearLayout>
