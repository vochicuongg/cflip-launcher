<?xml version="1.0" encoding="utf-8"?>
<!-- vc246 CASSETTE SMALL (9Flip: Cassette Small) — compact music widget,
     same ids as widget_music so MusicWidgetProvider's onUpdate works
     unchanged (actions for ids absent here — refresh/state/progress —
     are no-ops in RemoteViews). Title + artist, tape window, 3 controls.
     352x160dp, keyguard/cover only. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/bg_widget_card"
    android:padding="12dp">
    <TextView
        android:id="@+id/music_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:ellipsize="end"
        android:text="Chưa có nhạc"
        android:textColor="#F5F7F6"
        android:textSize="14sp"
        android:textStyle="bold" />
    <TextView
        android:id="@+id/music_artist"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:ellipsize="end"
        android:text="Mở nhạc rồi bấm làm mới"
        android:textColor="#9AA8A1"
        android:textSize="12sp" />
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/bg_widget_tape"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:paddingTop="6dp"
        android:paddingBottom="6dp">
        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_w_reel"
            android:contentDescription="Cuộn băng" />
        <View
            android:layout_width="0dp"
            android:layout_height="2dp"
            android:layout_weight="1"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="10dp"
            android:background="#337FE3C0" />
        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_w_reel"
            android:contentDescription="Cuộn băng" />
    </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center">
            <ImageButton android:id="@+id/music_prev" android:layout_width="48dp" android:layout_height="48dp"
                android:background="@drawable/bg_widget_circle" android:src="@drawable/ic_w_prev"
                android:padding="12dp" android:scaleType="fitCenter" android:contentDescription="Bài trước" />
        </LinearLayout>
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center">
            <ImageButton android:id="@+id/music_playpause" android:layout_width="56dp" android:layout_height="56dp"
                android:background="@drawable/bg_widget_circle_active" android:src="@drawable/ic_w_play"
                android:padding="12dp" android:scaleType="fitCenter" android:contentDescription="Phát / tạm dừng" />
        </LinearLayout>
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center">
            <ImageButton android:id="@+id/music_next" android:layout_width="48dp" android:layout_height="48dp"
                android:background="@drawable/bg_widget_circle" android:src="@drawable/ic_w_next"
                android:padding="12dp" android:scaleType="fitCenter" android:contentDescription="Bài kế" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
