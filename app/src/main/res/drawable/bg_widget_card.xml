<?xml version="1.0" encoding="utf-8"?>
<!-- vc247 DEPTH: the flat #16181C card is now a diagonal gradient
     (#1E2126 -> #101214) so every widget reads as a layered surface
     instead of a flat slab. Stroke + 20dp corners unchanged. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android">
    <gradient
        android:angle="135"
        android:startColor="#1E2126"
        android:endColor="#101214"
        android:type="linear" />
    <stroke android:width="1dp" android:color="#297FE3C0" />
    <corners android:radius="20dp" />
</shape>
