<?xml version="1.0" encoding="utf-8"?>
<!-- vc242 LOGO: flip-phone mark, traced from ~/workspace/cflip-vc242-logo/icon-master.png (kept outside the repo — snapshot push rejects binaries).
     Two rounded panels (the folded Flip5, seen from the side) joined by a
     hinge at the right, drawn as mint strokes on the #111111 adaptive-icon
     background (see colors.xml ic_launcher_background). Stroke-only, no
     fill, so it stays crisp from 48dp up to the Play-style 512dp render.
     Previous mark was a plain white rectangle + black line. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp" android:height="108dp"
    android:viewportWidth="108" android:viewportHeight="108">
    <!-- Top panel: rounded rect (24,20)-(84,50), r=10 -->
    <path android:fillColor="#00000000"
        android:strokeColor="#7FE3C0" android:strokeWidth="4"
        android:strokeLineCap="round" android:strokeLineJoin="round"
        android:pathData="M34,20 H74 A10,10 0 0,1 84,30 V40 A10,10 0 0,1 74,50 H34 A10,10 0 0,1 24,40 V30 A10,10 0 0,1 34,20 Z" />
    <!-- Bottom panel: rounded rect (24,58)-(84,88), r=10 -->
    <path android:fillColor="#00000000"
        android:strokeColor="#7FE3C0" android:strokeWidth="4"
        android:strokeLineCap="round" android:strokeLineJoin="round"
        android:pathData="M34,58 H74 A10,10 0 0,1 84,68 V78 A10,10 0 0,1 74,88 H34 A10,10 0 0,1 24,78 V68 A10,10 0 0,1 34,58 Z" />
    <!-- Hinge: two short ticks between the panels, deeper mint -->
    <path android:fillColor="#00000000"
        android:strokeColor="#2FBF8F" android:strokeWidth="3"
        android:strokeLineCap="round"
        android:pathData="M68,50 L68,58 M76,50 L76,58" />
</vector>
