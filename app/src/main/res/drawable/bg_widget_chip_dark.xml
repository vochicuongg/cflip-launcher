<?xml version="1.0" encoding="utf-8"?>
<!-- vc247: dark info chip (clock battery / notification counts) — a
     lifted surface above the card gradient, with a hairline border,
     so the counts read as separate glanceable pills. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="#20242A" />
    <stroke android:width="1dp" android:color="#2E333A" />
    <corners android:radius="10dp" />
</shape>
