<?xml version="1.0" encoding="utf-8"?>
<!-- vc153 press feedback for widget cells. RemoteViews cannot run view
     animations (the host renders the widget in another process), so a
     state-list background is the tap response the widget can have:
     pressed cells brighten briefly, released cells go transparent. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Active effect (user, 2026-11-21): the pressed state is a
         shaped mint glow matching the tile's corners, not the old
         flat colour wash. -->
    <item android:state_pressed="true" android:drawable="@drawable/bg_widget_cell_pressed" />
    <!-- vc247: resting cells are a lifted tile now, not transparent. -->
    <item android:drawable="@drawable/bg_widget_cell" />
</selector>
