<?xml version="1.0" encoding="utf-8"?>
<!-- vc247 DEPTH: the tape window is now a vertical gradient
     (#14181C -> #0A0C0D) so the cassette reads as an inset strip
     with the reels sitting inside it, not a flat dark bar. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="90"
        android:startColor="#14181C"
        android:endColor="#0A0C0D"
        android:type="linear" />
    <stroke android:width="1dp" android:color="#297FE3C0" />
    <corners android:radius="12dp" />
</shape>
