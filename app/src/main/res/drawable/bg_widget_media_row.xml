<?xml version="1.0" encoding="utf-8"?>
<!-- vc247: now-playing row on the Cover widget — a lifted strip above
     the card gradient so the playing track reads as its own line,
     not a loose grey caption. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="#14171B" />
    <stroke android:width="1dp" android:color="#23282D" />
    <corners android:radius="12dp" />
</shape>
