<?xml version="1.0" encoding="utf-8"?>
<!-- App-grid item entry: a soft settle (fade + slight rise +
     scale up) played by the GridView's layout animation when the
     grid's content is (re)bound — opening a group, going back, or
     a refresh. RemoteViews cannot run view animations directly;
     a layout animation on the collection is the one transition
     the host itself applies, when it honours it. Short on
     purpose: it must never feel like it delays the grid. -->
<set xmlns:android="http://schemas.android.com/apk/res/android"
    android:interpolator="@android:anim/decelerate_interpolator">
    <alpha
        android:fromAlpha="0.0"
        android:toAlpha="1.0"
        android:duration="150" />
    <scale
        android:fromXScale="0.88"
        android:toXScale="1.0"
        android:fromYScale="0.88"
        android:toYScale="1.0"
        android:pivotX="50%"
        android:pivotY="50%"
        android:duration="210" />
    <translate
        android:fromYDelta="12%"
        android:toYDelta="0"
        android:duration="210" />
</set>
