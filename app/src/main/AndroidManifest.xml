<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Personal-use sideload build. QUERY_ALL_PACKAGES is restricted on Google Play,
         but this project is NOT intended for Play distribution. -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <!-- Recents from real usage data (user grants Usage Access in system settings) -->
    <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />
    <!-- Brightness control (user grants "Modify system settings" per-app) -->
    <uses-permission android:name="android.permission.WRITE_SETTINGS"
        tools:ignore="ProtectedPermissions" />
    <!-- Real wave amplitude: Visualizer on the output mix (vc142, normal permission, no runtime prompt) -->
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- vc150 BOOT RESTORE: normal permission, auto-granted, no runtime prompt -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-feature android:name="android.hardware.camera.flash" android:required="false" />

    <application
        android:name=".CFlipApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.CFlipLauncher">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- vc32: MediaProjection permission activity for the panel Mirror
             tile (like 9Flip's MirrorPermissionActivity in architecture).
             Translucent, no UI of its own — only the system capture dialog
             shows, on the main display. Not exported. -->
        <!-- vc34: separate task affinity + excludeFromRecents, so the
             permission activity never brings MainActivity forward and
             never looks like re-entering the CFlip app. It only shows
             the system sharing dialog, then removes its own task. -->
        <activity
            android:name=".mirror.MirrorPermissionActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:launchMode="singleTop"
            android:configChanges="density|smallestScreenSize|screenSize|uiMode|screenLayout|orientation"
            android:resizeableActivity="true"
            android:taskAffinity="com.cuong.cflip.mirror"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />

        <!-- vc83: dedicated dual host (9Flip host-first flow, own code).
             Tile opens this on the cover; it enables dual only when
             top-resumed, then launches MirrorPermissionActivity on the
             cover. It never shows a dialog and never disables dual
             on death; service cleanup owns dual disable. -->
        <activity
            android:name=".mirror.DualHostActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:launchMode="singleTask"
            android:configChanges="density|smallestScreenSize|screenSize|uiMode|screenLayout|orientation"
            android:resizeableActivity="true"
            android:taskAffinity="com.cuong.cflip.dualhost"
            android:theme="@android:style/Theme.Translucent.NoTitleBar">
            <!-- vc186 SAMSUNG COVER FLAG (PowerFlip
                 CoverMirrorActivity parity, manifest only):
                 marks this cover host as a legitimate
                 cover-screen activity. Hypothesis: Samsung
                 keeps flagged cover-stack members across
                 a cover-stack reset, while CFlip's unflagged
                 mirror window gets swept. -->
            <meta-data
                android:name="com.samsung.android.multiwindow.show_on_cover"
                android:value="true" />
        </activity>

        <!-- vc95: lock bubble activity (9Flip UnlockActivity pattern,
             own code). An Activity window with setShowWhenLocked,
             so it is visible over the secure keyguard where the
             overlay bubble is hidden. Launched on the cover by
             CoverForegroundService only while locked; tap asks
             the system to dismiss the keyguard, then the normal
             overlay bubble returns. Never exported, never in
             recents, singleTop so relaunches reuse it. -->
        <activity
            android:name=".cover.CoverUnlockActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:launchMode="singleTop"
            android:configChanges="density|smallestScreenSize|screenSize|uiMode|screenLayout|orientation"
            android:resizeableActivity="true"
            android:taskAffinity="com.cuong.cflip.unlock"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />

        <!-- vc86: main-side host for mirror (9Flip host-on-main pattern).
             Launched by MirrorPermissionActivity on display 0 right
             after grant; keeps the folded main display awake for
             AUTO_MIRROR capture. 1x1 transparent, never disables dual
             on death, finishes when MirrorState stops. -->
        <activity
            android:name=".mirror.MainHostActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:launchMode="singleTask"
            android:configChanges="density|smallestScreenSize|screenSize|uiMode|screenLayout|orientation"
            android:resizeableActivity="true"
            android:taskAffinity="com.cuong.cflip.mainhost"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />

        <!-- Keeps cover-related work alive while the phone is folded -->
        <service
            android:name=".service.CoverForegroundService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="cover_screen_launcher" />
        </service>

        <!-- vc150 BOOT RESTORE (user, 29/10): after a reboot or an app
             update, bring the opener back exactly as the user left it:
             Quick Panel ON -> start CoverForegroundService (its own
             guards decide whether the opener shows); Quick Panel OFF
             -> nothing. The widget setting needs no boot action: it
             already persists and the panel re-reads it on every open.
             No LOCKED_BOOT_COMPLETED on purpose: before first unlock
             the settings file is still encrypted and the lock rule
             forbids openers on the lock screen anyway. -->
        <receiver
            android:name=".service.BootReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- Floating bubble menu: CFlip's own overlay surface (deprecated, see BubbleControls) -->
        <service
            android:name=".service.BubbleOverlayService"
            android:exported="false" />

        <!-- Screen mirroring: MediaProjection foreground service (user approves
             the system capture dialog every session - Android requirement) -->
        <service
            android:name=".service.ScreenMirrorService"
            android:exported="false"
            android:foregroundServiceType="mediaProjection" />

        <!-- Notifications: list, actions, media sessions -->
        <service
            android:name=".service.MyNotificationListenerService"
            android:exported="false"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!-- Gestures / cover interaction hooks (scaffold: logging + TODO hooks) -->
        <service
            android:name=".service.MyAccessibilityService"
            android:exported="false"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

        <!-- Standard widget (3.1.0): user-placed only, via the system
             picker or requestPinAppWidget from MainScreen. Never forced. -->
        <receiver
            android:name=".widget.CoverWidgetProvider"
            android:exported="false"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/cover_widget_info" />
            <!-- Samsung cover widget (3.3.0, decompiled from 9Flip v149):
                 without this, Samsung's cover widget picker never lists
                 this provider. With it, the widget can be added from the
                 folded cover, without opening the main screen. -->
            <meta-data
                android:name="com.samsung.android.appwidget.provider"
                android:resource="@xml/samsung_cover_widget_info" />
        </receiver>

        <!-- Standard widgets: App Grid, Music, Clock & Battery. Each is a
             separate provider so the user can place exactly the ones they
             want, via the system picker / pin dialog only. -->
        <receiver
            android:name=".widget.AppGridWidgetProvider"
            android:exported="true"
            android:label="CFlip — Lưới ứng dụng">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/appgrid_widget_info" />
            <!-- Samsung cover widget (3.3.0, decompiled from 9Flip v149):
                 without this, Samsung's cover widget picker never lists
                 this provider. With it, the widget can be added from the
                 folded cover, without opening the main screen. -->
            <meta-data
                android:name="com.samsung.android.appwidget.provider"
                android:resource="@xml/samsung_appgrid_widget_info" />
        </receiver>

        <!-- 3.5.0: exported=true, like 9Flip's RemoteViewsService.
             BIND_REMOTEVIEWS still restricts binding to system hosts,
             but exported=false can stop Samsung's cover host from
             binding the grid service at all. -->
        <service
            android:name=".widget.AppGridRemoteViewsService"
            android:exported="true"
            android:permission="android.permission.BIND_REMOTEVIEWS" />

        <receiver
            android:name=".widget.MusicWidgetProvider"
            android:exported="false"
            android:label="CFlip — Nhạc">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/music_widget_info" />
            <!-- Samsung cover widget (3.3.0, decompiled from 9Flip v149):
                 without this, Samsung's cover widget picker never lists
                 this provider. With it, the widget can be added from the
                 folded cover, without opening the main screen. -->
            <meta-data
                android:name="com.samsung.android.appwidget.provider"
                android:resource="@xml/samsung_music_widget_info" />
        </receiver>

        <receiver
            android:name=".widget.ClockWidgetProvider"
            android:exported="false"
            android:label="CFlip — Đồng hồ &amp; Pin">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/clock_widget_info" />
            <!-- Samsung cover widget (3.3.0, decompiled from 9Flip v149):
                 without this, Samsung's cover widget picker never lists
                 this provider. With it, the widget can be added from the
                 folded cover, without opening the main screen. -->
            <meta-data
                android:name="com.samsung.android.appwidget.provider"
                android:resource="@xml/samsung_clock_widget_info" />
        </receiver>

    </application>
</manifest>
